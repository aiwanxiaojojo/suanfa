{
    "tasks": [
        {
            "label": "结束旧的调试程序",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-Command",
                "Get-Process -Name program -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue; exit 0"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "C/C++: g++.exe 生成活动文件",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\build-cpp.ps1",
                "-SourceFile",
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "结束旧的调试程序",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "使用 MinGW-w64 GCC 编译当前 C++ 文件到 .vscode\\build\\program.exe"
        },
        {
            "label": "运行当前 C++ 程序（可输入）",
            "type": "shell",
            "command": "& '${workspaceFolder}\\.vscode\\build\\program.exe'",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "C/C++: g++.exe 生成活动文件",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ],
    "version": "2.0.0"
}
